---
import { SITE_CONFIG } from '../config.ts';

interface Props {
  baseTheme?: string;
}

const { baseTheme = SITE_CONFIG.baseTheme } = Astro.props;
---

<meta name="theme-color" content="#000000" id="theme-color-meta" />
<script is:inline define:vars={{ baseTheme }}>
  (() => {
    function getSystemTheme() {
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      return prefersDark ? `${baseTheme}-dark` : `${baseTheme}-light`;
    }

    const savedTheme = localStorage.getItem('theme');
    const activeTheme = (savedTheme && savedTheme.startsWith(baseTheme))
      ? savedTheme
      : getSystemTheme();

    document.documentElement.setAttribute('data-theme', activeTheme);

    // mobile status bar mode
    const meta = document.getElementById('theme-color-meta');
    const syncMeta = () => {
      if (!meta) return;
      const bg = getComputedStyle(document.documentElement).getPropertyValue('--color-background').trim();
      meta.setAttribute('content', bg || (document.documentElement.getAttribute('data-theme').endsWith('-dark') ? '#000000' : '#FFFFFF'));
    };
    // CSS variables are available once the stylesheet is parsed
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncMeta, { once: true });
    } else {
      syncMeta();
    }

    // listen to system theme changes, if the user hasn't explicitly set a preference
    if (window.matchMedia) {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      const handleSystemThemeChange = (e) => {
        const currentSaved = localStorage.getItem('theme');
        if (!currentSaved || !currentSaved.startsWith(baseTheme)) {
          const newTheme = e.matches ? `${baseTheme}-dark` : `${baseTheme}-light`;
          document.documentElement.setAttribute('data-theme', newTheme);
          syncMeta();
        }
      };

      if (mediaQuery.addEventListener) {
        mediaQuery.addEventListener('change', handleSystemThemeChange);
      } else if (mediaQuery.addListener) {
        mediaQuery.addListener(handleSystemThemeChange);
      }
    }
  })();
</script>
